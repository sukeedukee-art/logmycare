# CareLink Dashboard - local settings template
#
# 1. Copy this file to ".env" in the same folder.
# 2. Fill in the values. ".env" is git-ignored and is never served by server.py.
# Anything left empty is asked for in the terminal when the dashboard starts.
# On GitHub Actions these come from repository secrets instead.

# Log My Care login (used by the scraper)
LMC_EMAIL=
LMC_PASSWORD=

# Mailbox the "Email key worker" button sends from (Google Workspace + App Password)
SMTP_USER=
SMTP_PASSWORD=

# Optional - defaults shown
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=CareLink Dashboard
